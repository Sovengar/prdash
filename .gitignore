bin/
*.test

# Worktrees de Worktrunk (wt). DENTRO del repo a propósito: los tiene el global
# worktree-path. git y fd los ignoran por estar aquí, pero `gofmt -l .` NO lee
# el .gitignore y sí desciende: por eso `make test` formatea con
# `git ls-files '*.go'` y no con `gofmt -l .`.
.worktrees/

# Mutation testing (gremlins)
report.json
.gremlins*
