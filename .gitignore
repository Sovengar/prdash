bin/
*.test

# Worktrunk (wt) worktrees. INSIDE the repo on purpose: the global worktree-path
# puts them there. git and fd ignore them for being here, but `gofmt -l .` does
# NOT read the .gitignore and does descend: that is why `make test` formats with
# `git ls-files '*.go'` and not with `gofmt -l .`.
.worktrees/

# Mutation testing (gremlins)
report.json
.gremlins*
# Local Pi runtime state
.atl/

# Local coverage (regenerated by `go test -coverprofile`)
coverage.out
